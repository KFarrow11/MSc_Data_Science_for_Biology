theme_classic() +
custom_theme3()
# The scree plot or eigenvalues plot can also help visualize the importance of each principal component in explaining the variance, guiding you in selecting the number of components for further analysis.
# Results for Variables ----
res.var <- get_pca_var(pca) # extracts the variables' results from the PCA
res.var$coord          # Variable Coordinates = variables with high absolute values in a given principal component are significant contributors to that component.
# Dim.1: This dimension is heavily influenced by juncus_cover (positive influence), water_table_depth (negative influence), and num_ditches (negative influence). It indicates that these variables are the major contributors to the variability explained by Dim.1.
# Dim.2: The main contributors are birch_cover, willow_cover, and swardht, all with negative influences. This suggests that these variables play a significant role in explaining the variability captured by Dim.2.
# Dim.3: sand_gravel_cover and num_sedgepools positively influence this dimension, whereas num_ditches negatively influences it. This indicates that these variables explain a significant part of the variability in Dim.3.
# Dim.4: sand_gravel_cover, pool_cover, and num_sedgepools are the major positive influences on Dim.4, contributing to the variance explained by this component.
res.var$contrib        # Contributions = variables with high contributions are key drivers of the patterns observed in the PCA.
# Dim.1: The most significant contributors to the first principal component are water_table_depth (26.42%) and juncus_cover (25.33%). This indicates that these two variables strongly influence the variation captured by PC1. Additionally, num_ditches (16.91%) and num_sedgepools (10.53%) also have notable contributions, indicating that they are important in explaining the variation along this dimension.
# Dim.2: The major contributors to PC2 are birch_cover (35.07%) and willow_cover (21.34%), showing that these variables are dominant in explaining the variance along this axis. Furthermore, swardht (15.56%) and **elevation** (9.71%) also play significant roles, suggesting their influence on the variation captured by PC2.
# Dim.3: The most significant variables for PC3 are sand_gravel_cover (32.07%) and num_sedgepools (17.55%), highlighting their importance in explaining the variance on this dimension. Hayfield (16.79%) and num_ditches (12.78%) also contribute substantially, indicating their relevance to PC3.
# Dim.4:The primary contributors to PC4 are pool_cover (19.06%) and sand_gravel_cover (14.15%), suggesting their strong influence on the variation along this axis. Num_sedgepools (12.89%) and water_table_depth (12.65%) also have significant contributions, indicating their importance to PC4.
# Results for individuals ----
res.ind <- get_pca_ind(pca)
res.ind$coord          # Ind Coordinates = individuals close to each other in the PCA space have similar profiles based on the original variables.
#Combine the original godwit data and the PC Dimension coords (loadings) into a list res.ind$coord
pca_list <- list(pca_godwits, res.ind$coord)
pca_scores <- as.data.frame(pca_list) # Convert list to data frame godwit_pca1
glimpse(pca_scores)
