# Combine contributions from all dimensions into a single data frame
combined_data <- data.frame(
Environmental_Factor = c(
"Birch cover", "Willow cover", "Sward grass height (cm)", "Elevation (m)",
"Distance from Hayfield", "Pool cover", "Watertable depth",
"Pools with sedge plants", "Juncus cover", "Sand/Gravel cover",
"Number of ditches"
),
Dim1 = get_pca_var(pca)$contrib[, 1],
Dim2 = get_pca_var(pca)$contrib[, 2],
Dim3 = get_pca_var(pca)$contrib[, 3],
Dim4 = get_pca_var(pca)$contrib[, 4]
)
# Reshape data for ggplot
plot_data <- combined_data %>%
pivot_longer(cols = Dim1:Dim4, names_to = "Dimension", values_to = "Contribution") %>%
arrange(Dimension, Contribution)  # Sort first by Dimension, then Contribution in ascending order
# Reverse the order of Environmental_Factor for plotting
plot_data$Environmental_Factor <- factor(plot_data$Environmental_Factor, levels = rev(unique(plot_data$Environmental_Factor)))  # Reverse order
# Maintain PCA legend order as "1, 2, 3, 4"
plot_data$Dimension <- factor(plot_data$Dimension, levels = c("Dim1", "Dim2", "Dim3", "Dim4"))
# combined plot with natural and distinct colors
combined_plot2 <- ggplot(plot_data, aes(x = Environmental_Factor, y = Contribution, fill = Dimension)) +
geom_bar(stat = "identity", position = "dodge") +
theme_classic() +
custom_theme3() +
coord_flip() +
labs(
title = "Environmental Factors Contributions Across All Dimensions",
x = "Environmental Factors",
y = "Contributions (%)",
fill = "PCA"  # Change the legend title to "PCA"
) +
scale_fill_manual(
values = c("#B22222", "#8B4513", "#DAA520", "#5DA9E9"),  # Colors mapped for correct PCA order
labels = c("1", "2", "3", "4")                           # Legend labels in natural order
)
combined_plot2
