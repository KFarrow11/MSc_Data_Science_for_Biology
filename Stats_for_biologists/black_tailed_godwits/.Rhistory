# ________________________________________________________________________----
# pca Scatter plot ----
pca_plot <- function(data, x_var, x_lab, plot_title) {
ggplot(data, aes_string(x = x_var, y = "god_occur")) +
geom_hline(yintercept = 0.5, linetype = "dashed", color = "black") +
geom_point(position = "jitter", color = "black") +
scale_y_continuous(
breaks = c(0, 1),
labels = c("Absent", "Present")
) +
theme_classic() +
custom_theme() +
labs(
y = "Black-tailed Godwit",
x = x_lab,
title = plot_title
)
}
# Create a scatter plot to look at the relationship between Dim.1 and godwit presence/absence
dim1_pca_plot <- pca_plot(pca_scores, "Dim.1", "PC1", "Relationship Between Black-tailed Godwit Presence and Principal Component 1 (PC1)") +
geom_smooth(method = 'lm') # Fit a line using the method `lm`
dim1_pca_plot
# ----
# Scatter-plot for any variable with a strong positive correlation with Dim.1, against Dim.1
pca_results <- data.frame(pca$x)
pca_results$juncus_cover <- pca_godwits$juncus_cover
# Create the scatter plot
ggplot(pca_results, aes(x = PC1, y = juncus_cover)) +
geom_point(position = "jitter") +
geom_smooth(method = 'lm') +
theme_classic() +
labs(
title = "Juncus Cover vs Principal Component 1",
x = "PC 1",
y = "Juncus Cover"
) +
ylim(0, 80)
# Variables strongly associated with the second component
# Birch Cover vs Dim.2
